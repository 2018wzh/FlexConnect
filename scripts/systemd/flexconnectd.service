[Unit]
Description=FlexConnect AnyConnect daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=flexconnect
UMask=0007
RuntimeDirectory=flexconnect
RuntimeDirectoryMode=0750
StateDirectory=flexconnect
StateDirectoryMode=0700
ExecStart=/usr/sbin/flexconnectd --socket /run/flexconnect/flexconnect.sock --state /var/lib/flexconnect/state.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
